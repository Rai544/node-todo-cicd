pipeline {
    agent any
    
    environment {
        AWS_ACCOUNT_ID = credentials('aws-account-id')
    }
    stages {
        stage('code') {
            steps {
                echo 'code is cloning in this stage'
                git url:'https://github.com/Rai544/node-todo-cicd.git/', branch:'main'
            }
        }
        stage('Build') {
            steps {
                echo 'code is building in this stage'
                sh 'docker build -t dev/node-app .'
            }
        }
        stage('Login to ECR') {
            steps {
                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: 'aws-ecr-creds'
                    ]]) {
                    echo "loginn ECR"
                    sh "aws ecr get-login-password --region eu-north-1 | docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.eu-north-1.amazonaws.com"
                    echo "ECR login Seccessfully"
                }
            }
        }
        stage('Tag and push image') {
            steps {
                echo 'Tag and Push the Image'
                sh "docker tag dev/node-app:latest ${AWS_ACCOUNT_ID}.dkr.ecr.eu-north-1.amazonaws.com/dev/node-app:latest"
                echo "image taged"
                sh "docker push ${AWS_ACCOUNT_ID}.dkr.ecr.eu-north-1.amazonaws.com/dev/node-app:latest"
                echo "image Pushed Successfully"
            }
        }
        stage('SSH into EC2 and run docker compose on EC2') {
            steps {
                sshagent(['ec2-ssh-key']) {
                    sh '''
                    ssh -o StrictHostKeyChecking=no ubuntu@51.21.192.32 << 'EOF'
                    
                    echo "SSH successfully"
                    
                    mkdir ~/node-app
                    cd node-app
                    
                    if [ -d ".git" ]; then
                        git pull origin main
                    else
                        git clone https://github.com/Rai544/node-todo-cicd.git .
                    fi
                    aws ecr get-login-password --region eu-north-1 | docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.eu-north-1.amazonaws.com
                    docker compose down
                    docker compose up -d
                    
EOF
                    '''
                }
            }
        }
        stage('Deploy') {
            steps {
                echo 'code is deploying in this stage'
            }
        }
    }
}
